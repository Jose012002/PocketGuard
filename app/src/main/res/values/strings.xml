    <!-- Onboarding (CU-01) -->
    <string name="onboarding_step_indicator">Paso %1$d de %2$d</string>
    <string name="onboarding_intro_1_title">Protege tu teléfono</string>
    <string name="onboarding_intro_1_body">PocketGuard es una alarma antirrobo: la armas, guardas el teléfono en el bolsillo o la mochila y, si alguien lo saca, suena una sirena.</string>
    <string name="onboarding_intro_2_title">Tres sensores trabajan juntos</string>
    <string name="onboarding_intro_2_body">Para evitar falsas alarmas, solo suena cuando coinciden la proximidad, la luz y el movimiento. Caminar con el teléfono guardado no la activa.</string>
    <string name="onboarding_intro_3_title">Tú decides cuándo se detiene</string>
    <string name="onboarding_intro_3_body">Solo tu PIN, o tu huella si la habilitas, desactiva la alarma. Primero vas a crear tu PIN.</string>
    <string name="onboarding_create_pin_title">Crea tu PIN</string>
    <string name="onboarding_create_pin_subtitle">De 4 a 6 dígitos. Lo necesitarás para desarmar la alarma.</string>
    <string name="onboarding_confirm_pin_title">Confirma tu PIN</string>
    <string name="onboarding_confirm_pin_subtitle">Ingrésalo otra vez para asegurarnos de que lo recuerdas.</string>
    <string name="onboarding_error_too_short">El PIN debe tener al menos 4 dígitos.</string>
    <string name="onboarding_error_mismatch">Los PIN no coinciden. Vuelve a crearlo.</string>
    <string name="onboarding_error_save_failed">No se pudo guardar el PIN. Inténtalo de nuevo.</string>
    <string name="onboarding_permissions_title">Permite las notificaciones</string>
    <string name="onboarding_permissions_body">La alarma usa una notificación para avisarte de su estado y para mostrar la pantalla de desbloqueo cuando alguien saca el teléfono.</string>
    <string name="onboarding_permissions_allow">Permitir notificaciones</string>
    <string name="onboarding_permissions_denied">Sin notificaciones la alarma no podrá mostrar su estado ni la pantalla de desbloqueo. Puedes activarlas en los ajustes del sistema.</string>
    <string name="onboarding_permissions_continue_anyway">Continuar de todos modos</string>

